# 이 파일을 복사해 .env 로 만들고 값을 채우세요.
#   Windows: copy .env.example .env    macOS/Linux: cp .env.example .env
# .env 는 절대 Git에 올리지 않습니다. (값 뒤에 같은 줄 주석을 달지 마세요)

FLASK_APP=wsgi.py
# dev | prod
APP_ENV=dev
# python -c "import secrets; print(secrets.token_hex(32))" 결과를 붙여넣기
SECRET_KEY=
# 비우면 instance/dev.db (SQLite) 사용. 배포 시 PostgreSQL 주소
DATABASE_URL=

# ── AI 코멘트 (선택) ────────────────────────────────────────
# platform.openai.com/api-keys 에서 발급한 API 키. 비우면 규칙 기반 기본 코멘트만 나와요.
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini

# 로컬 전용: 이 이메일 계정으로 바로 들어가요. 비우면 브라우저마다 개인 공간. 배포에서는 무시돼요
OWNER_EMAIL=

# ── 파일 업로드 ─────────────────────────────────────────────
MAX_UPLOAD_MB=10

